datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  // ... existing fields ...
  createdEquipmentCategories EquipmentCategory[] @relation("CreatedByUser")
  id           String              @id @default(uuid())
  email        String              @unique
  password     String
  name         String
  role         String              @default("STAFF") // MEDIA_MANAGER, TECHNICAL_MANAGER, STAFF
  status       String              @default("ACTIVE") // ACTIVE, INACTIVE, ARCHIVED
  isArchived   Boolean             @default(false)
  archivedAt   DateTime?
  avatarUrl    String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  employeeProfile    EmployeeProfile?
  tasks              TaskAssignment[]
  createdProjects    ShootProject[]      @relation("ProjectCreator")
  projectAssignments ProjectAssignment[]
  attendanceRecords           Attendance[]        @relation("AttendanceUser")
  recordedAttendanceRecords   Attendance[]        @relation("AttendanceRecordedBy")
  fileUploads        FileMetadata[]
  communications     Communication[]     @relation("CommunicationSender")
  assignedBlockers   Communication[]     @relation("BlockerAssignedTo")
  resolvedBlockers   Communication[]     @relation("BlockerResolvedBy")
  notifications      Notification[]      @relation("NotificationRecipient")
  notificationsRead  Notification[]      @relation("NotificationReadBy")
  activityLogs       ActivityLog[]
  approvalsRequested Approval[]          @relation("ApprovalRequester")
  approvalsReviewed  Approval[]          @relation("Approver")
  equipmentMovements EquipmentMovement[]
  scriptAssignments  ScriptAssignment[]
  scriptTimelines    ScriptTimeline[]
  scriptRemarks      ScriptRemark[]
  taskRemarks        TaskRemark[]
  deliverableUploads TaskDeliverableHistory[]
  taskTimelines      TaskTimeline[]
  graphicRequirementTimelines GraphicRequirementTimeline[]
  graphicRequirementRemarks GraphicRequirementRemark[]
  equipmentReservations EquipmentReservation[] @relation("ReservationCreator")
  equipmentRequests     EquipmentRequest[]     @relation("EquipmentRequester")
  equipmentRequestReviews EquipmentRequest[]   @relation("EquipmentRequestReviewer")
  equipmentIssuedTo     EquipmentMovement[]    @relation("EquipmentIssuedTo")
  equipmentApprovedBy   EquipmentMovement[]    @relation("EquipmentApprovedBy")
  equipmentReturnedBy   EquipmentMovement[]    @relation("EquipmentReturnedBy")
  equipmentDamageReports EquipmentDamageReport[] @relation("EquipmentDamageReporter")
  handoverToEmployee    EquipmentHandoverAuthorization[] @relation("HandoverToEmployee")
  handoverIssuedBy      EquipmentHandoverAuthorization[] @relation("HandoverIssuedBy")
  maintenanceClearedBy  EquipmentMaintenanceRecord[]     @relation("MaintenanceClearedBy")

  revisionsRequested Revision[] @relation("RevisionRequestedBy")
  revisionsOriginal  Revision[] @relation("RevisionOriginalAssignee")
  revisionsAssigned  Revision[] @relation("RevisionAssignedTo")

  clientAssignments         ClientAssignment[]
  createdCalendarEvents     MediaCalendarEvent[]      @relation("CalendarEventCreator")
  assignedCalendarEvents    MediaCalendarEvent[]      @relation("CalendarEventAssignedStaff")
  approvedCalendarEvents    MediaCalendarEvent[]      @relation("CalendarEventApprover")
  calendarRevisions         CalendarEventRevision[]
  calendarApprovalHistories CalendarApprovalHistory[]
  lastModifiedCalendarEvents MediaCalendarEvent[]     @relation("CalendarEventLastModifiedBy")
  editRequestedCalendarEvents MediaCalendarEvent[]    @relation("CalendarEventEditRequestedBy")
  editApprovedCalendarEvents  MediaCalendarEvent[]    @relation("CalendarEventEditApprovedBy")
  submittedEditRequests       CalendarEditRequest[]   @relation("CalendarEditRequestedBy")
  reviewedEditRequests        CalendarEditRequest[]   @relation("CalendarEditReviewedBy")
  editHistoriesRequested      CalendarEditHistory[]   @relation("CalendarEditHistoryRequestedBy")
  editHistoriesApproved       CalendarEditHistory[]   @relation("CalendarEditHistoryApprovedBy")
  createdScripts            Script[]                  @relation("ScriptCreator")
  approvedScripts           Script[]                  @relation("ScriptApprover")
  createdGraphicDeliverables  GraphicRequirementDeliverable[] @relation("GraphicDeliverableCreatedBy")
  assignedGraphicDeliverables GraphicRequirementDeliverable[] @relation("GraphicDeliverableAssignedStaff")
}

model Department {
  id          String            @id @default(uuid())
  name        String            @unique
  description String?
  employees   EmployeeProfile[]
}

model Skill {
  id        String          @id @default(uuid())
  name      String          @unique
  category  String?
  employees EmployeeSkill[]
}

model EmployeeSkill {
  id         String          @id @default(uuid())
  employeeId String
  skillId    String
  employee   EmployeeProfile @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  skill      Skill           @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([employeeId, skillId])
}

model EmployeeProfile {
  id                    String          @id @default(uuid())
  employeeCode          String?         @unique
  userId                String          @unique
  user                  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone                 String?         // Mobile Number (Private)
  departmentId          String?
  department            Department?     @relation(fields: [departmentId], references: [id])
  additionalDepartments String?         // Comma-separated or JSON list of additional departments
  designation           String
  joiningDate           DateTime?       @default(now())
  employmentStatus      String          @default("ACTIVE") // ACTIVE, PROBATION, INACTIVE, ARCHIVED
  dailyCapacityHours    Float           @default(8.0)
  dailyTarget           Float           @default(1.0)
  weeklyTarget          Float           @default(5.0)
  monthlyTarget         Float           @default(20.0)
  internalNotes         String?         // Administrative notes
  skills                EmployeeSkill[]
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
}

model Client {
  id             String       @id @default(uuid())
  name           String
  companyName    String
  contactPerson  String
  mobile         String
  email          String
  address        String?
  gstNumber      String?
  website        String?
  status         String       @default("ACTIVE") // ACTIVE, INACTIVE, ON_HOLD, ARCHIVED
  onboardingDate DateTime     @default(now())
  internalNotes  String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  brands         Brand[]
  projects       ShootProject[]
  calendarEvents MediaCalendarEvent[]
  scripts        Script[]
  graphicReqs    GraphicRequirement[]
  tasks          Task[]
  assignedUsers  ClientAssignment[]
}

model Brand {
  id            String      @id @default(uuid())
  clientId      String
  client        Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name          String
  shortCode     String      @unique
  logoUrl       String?
  description   String?
  industry      String?
  primaryColor  String?     @default("#3B82F6")
  status        String      @default("ACTIVE") // ACTIVE, INACTIVE, ARCHIVED
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  products       Product[]
  projects       ShootProject[]
  calendarEvents MediaCalendarEvent[]
  scripts        Script[]
  graphicReqs    GraphicRequirement[]
  tasks          Task[]
}

model Product {
  id            String        @id @default(uuid())
  brandId       String
  brand         Brand         @relation(fields: [brandId], references: [id], onDelete: Cascade)
  name          String
  productCode   String
  category      String?
  status        String        @default("ACTIVE") // ACTIVE, INACTIVE, ARCHIVED
  internalNotes String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  projects       ShootProject[]
  calendarEvents MediaCalendarEvent[]
  scripts        Script[]
  graphicReqs    GraphicRequirement[]
  tasks          Task[]

  @@unique([brandId, productCode])
}

model Campaign {
  id          String   @id @default(uuid())
  name        String
  description String?
  startDate   DateTime
  endDate     DateTime
  createdAt   DateTime @default(now())

  projects    ShootProject[]
  scripts     Script[]
  graphicReqs GraphicRequirement[]
}

model MediaCalendarEvent {
  id                     String                    @id @default(uuid())
  eventId                String?                   @unique
  title                  String
  clientId               String
  client                 Client                    @relation(fields: [clientId], references: [id])
  brandId                String
  brand                  Brand                     @relation(fields: [brandId], references: [id])
  productId              String?
  product                Product?                  @relation(fields: [productId], references: [id])
  campaign               String?
  contentType            String?                   // Post, Reel, Story, Carousel, Video, Banner
  platform               String?                   // Instagram, Facebook, LinkedIn, YouTube, TikTok
  caption                String?                   // Caption / Copy
  creativePreviewUrl     String?                   // Image/video preview URL
  description            String?
  shootType              String                    @default("INDOOR") // INDOOR, OUTDOOR
  shootDate              DateTime
  clientApprovalDeadline DateTime?
  influencerTalent       String?
  priority               String                    @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  productionNotes        String?
  version                Int                       @default(1)
  createdById            String?
  createdBy              User?                     @relation("CalendarEventCreator", fields: [createdById], references: [id])
  createdByRole          String?
  assignedStaffId        String?
  assignedStaff          User?                     @relation("CalendarEventAssignedStaff", fields: [assignedStaffId], references: [id])
  approvalRequired       Boolean                   @default(true)
  approvalStatus         String?                   @default("PENDING_MARKETING_APPROVAL")
  approvalAssignedToId   String?
  approvalAssignedTo     User?                     @relation("CalendarEventApprover", fields: [approvalAssignedToId], references: [id])
  status                 String                    @default("DRAFT") // DRAFT, PENDING_CLIENT_REVIEW, CHANGES_REQUESTED, CLIENT_APPROVED, SCHEDULED, PUBLISHED, CANCELLED, REJECTED
  submittedAt            DateTime?
  reviewedAt             DateTime?
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @default(now()) @updatedAt

  eventSource            String                    @default("SHOOT") // GRAPHIC_REQUIREMENT, SHOOT
  graphicRequirementId   String?
  graphicRequirement     GraphicRequirement?       @relation("CalendarEventSourceGraphicReq", fields: [graphicRequirementId], references: [id])
  shootId                String?
  shoot                  ShootProject?             @relation("CalendarEventSourceShoot", fields: [shootId], references: [id])

  shootProjects          ShootProject[]
  graphicReqs            GraphicRequirement[]
  revisions              CalendarEventRevision[]
  approvalHistory        CalendarApprovalHistory[]
  lastModifiedById       String?
  lastModifiedBy         User?                     @relation("CalendarEventLastModifiedBy", fields: [lastModifiedById], references: [id])
  lastModifiedAt         DateTime?
  editRequestedById      String?
  editRequestedBy        User?                     @relation("CalendarEventEditRequestedBy", fields: [editRequestedById], references: [id])
  editApprovedById       String?
  editApprovedBy         User?                     @relation("CalendarEventEditApprovedBy", fields: [editApprovedById], references: [id])
  editApprovedAt         DateTime?

  editRequests           CalendarEditRequest[]
  editHistories          CalendarEditHistory[]
}

model ShootProject {
  id                     String         @id @default(uuid())
  projectId              String         @unique
  name                   String
  clientId               String
  client                 Client         @relation(fields: [clientId], references: [id])
  brandId                String
  brand                  Brand          @relation(fields: [brandId], references: [id])
  productId              String?
  product                Product?       @relation(fields: [productId], references: [id])
  campaignId             String?
  campaign               Campaign?      @relation(fields: [campaignId], references: [id])
  calendarEventId        String?
  calendarEvent          MediaCalendarEvent? @relation(fields: [calendarEventId], references: [id])
  shootType              String         // INDOOR, OUTDOOR
  shootDate              DateTime
  shootLocation          String
  locationCategory       String?
  locationAddress        String?
  locationContactPerson  String?
  reportingTime          String?
  expectedWrapUpTime     String?
  influencerTalent       String?
  priority               String         @default("MEDIUM")
  status                 String         @default("PLANNED")
  lifecycle              String         @default("ACTIVE") // ACTIVE, CLOSED, ARCHIVED
  estimatedCompletionDate DateTime?
  notes                  String?
  closureReason          String?
  progressPercentage     Int            @default(0)
  revisionCount          Int            @default(0)
  createdById            String
  createdBy              User           @relation("ProjectCreator", fields: [createdById], references: [id])
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  indoorDetails          IndoorShootDetails?
  outdoorDetails         OutdoorShootDetails?
  assignedTeam           ProjectAssignment[]
  scripts                Script[]
  graphicRequirements    GraphicRequirement[]
  tasks                  Task[]
  equipmentReservations  EquipmentReservation[]
  equipmentMovements     EquipmentMovement[]
  approvals              Approval[]
  clientConfirmations    ClientConfirmation[]
  revisions              Revision[]
  files                  FileMetadata[]
  communications         Communication[]
  equipmentRequests      EquipmentRequest[]
  handoverAuthorizations EquipmentHandoverAuthorization[]
  sourceForCalendarEvents MediaCalendarEvent[]     @relation("CalendarEventSourceShoot")
}

model IndoorShootDetails {
  id                    String              @id @default(uuid())
  projectId             String              @unique
  project               ShootProject        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  studioName            String
  studioAddress         String
  studioBookingStatus   String              @default("PENDING") // PENDING, CONFIRMED, CANCELLED
  studioBookingRef      String?
  reportingTime         String
  wrapUpTime            String
  indoorEquipmentReqs   String?
  lightingRequirements  String?
  indoorChecklist       String?
}

model OutdoorShootDetails {
  id                         String       @id @default(uuid())
  projectId                  String       @unique
  project                    ShootProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  outdoorLocation            String
  locationAddress            String
  locationCategory           String?
  locationContactPerson      String?
  permissionStatus           String       @default("PENDING") // NOT_REQUIRED, PENDING, APPROVED, REJECTED
  weatherStatus              String       @default("FAVORABLE") // FAVORABLE, RISK_RAIN, EXTREME_HEAT, POOR_LIGHT
  transportationReq          Boolean      @default(false)
  driver                     String?
  logisticsCoordinator       String?
  travelNotes                String?
  outdoorEquipmentReqs       String?
  droneRequirement           Boolean      @default(false)
  outdoorChecklist           String?

  // ── Outdoor Shoot Operational Fields ──────────────────
  exactLocationAddress       String?
  locationAccessDetails      String?
  locationContact            String?
  permitRequired             String?      @default("NO") // YES, NO
  permitStatus               String?      // Not Applied, Applied, Pending, Approved, Rejected
  expectedWeatherConditions  String?
  backupLocation             String?
  callTime                   String?
  expectedWrapTime           String?
  specialOutdoorRequirements String?
}

model ProjectAssignment {
  id         String       @id @default(uuid())
  projectId  String
  userId     String
  project    ShootProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleInProject String?
  assignedAt DateTime     @default(now())

  @@unique([projectId, userId])
}

model Script {
  id                 String       @id @default(uuid())
  scriptId           String       @unique
  name               String
  projectId          String
  project            ShootProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  clientId           String
  client             Client       @relation(fields: [clientId], references: [id])
  brandId            String
  brand              Brand        @relation(fields: [brandId], references: [id])
  productId          String?
  product            Product?     @relation(fields: [productId], references: [id])
  campaignId         String?
  campaign           Campaign?    @relation(fields: [campaignId], references: [id])
  language           String       @default("English")
  category           String       @default("Social Media")
  objective          String?
  description        String?
  estimatedDuration  String?
  status                      String       @default("DRAFT")
  priority                    String       @default("MEDIUM")
  remarks                     String?
  revisionCount               Int          @default(0)
  productionCompleted         Boolean      @default(false)
  technicalReviewApproved     Boolean      @default(false)
  mediaManagerReviewApproved  Boolean      @default(false)
  clientConfirmationRecorded  Boolean      @default(false)
  createdById                 String?
  createdBy                   User?        @relation("ScriptCreator", fields: [createdById], references: [id])
  approvedById                String?
  approvedBy                  User?        @relation("ScriptApprover", fields: [approvedById], references: [id])
  approvedAt                  DateTime?
  rejectedAt                  DateTime?
  rejectionReason             String?
  createdAt                   DateTime     @default(now())
  updatedAt                   DateTime     @updatedAt

  tasks              Task[]
  files              FileMetadata[]
  scriptAssignments  ScriptAssignment[]
  timeline           ScriptTimeline[]
  scriptRemarks      ScriptRemark[]
  deliverables       ScriptDeliverable[]
}

model ScriptAssignment {
  id             String   @id @default(uuid())
  scriptId       String
  script         Script   @relation(fields: [scriptId], references: [id], onDelete: Cascade)
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  responsibility String   @default("Writer") // Writer, Shooter, Video Editor, Motion Designer, Graphic Designer, Reviewer
  assignedAt     DateTime @default(now())

  @@unique([scriptId, userId, responsibility])
}

model ScriptTimeline {
  id          String    @id @default(uuid())
  scriptId    String
  script      Script    @relation(fields: [scriptId], references: [id], onDelete: Cascade)
  event       String    // SCRIPT_CREATED, ASSIGNED, PRODUCTION_STARTED, PRODUCTION_UPDATED, TECHNICAL_REVIEW, MEDIA_REVIEW, CLIENT_CONFIRMATION, REVISION_REQUESTED, COMPLETED, CLOSED
  description String?
  triggeredById String?
  triggeredBy   User?   @relation(fields: [triggeredById], references: [id])
  createdAt   DateTime  @default(now())
}

model ScriptRemark {
  id        String   @id @default(uuid())
  scriptId  String
  script    Script   @relation(fields: [scriptId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   String
  createdAt DateTime @default(now())
}

model ScriptDeliverable {
  id          String   @id @default(uuid())
  scriptId    String
  script      Script   @relation(fields: [scriptId], references: [id], onDelete: Cascade)
  type        String   // Reel, Advertisement Video, Long-form Video, Short-form Video, Story, Teaser, Custom
  title       String?  // Optional custom title
  description String?
  duration    String?  // e.g. "30s", "1m", "3m"
  status      String   @default("Pending") // Pending, In Progress, Done
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model GraphicRequirement {
  id                 String           @id @default(uuid())
  requirementId      String           @unique
  name               String
  projectId          String
  project            ShootProject     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  clientId           String
  client             Client           @relation(fields: [clientId], references: [id])
  brandId            String
  brand              Brand            @relation(fields: [brandId], references: [id])
  productId          String?
  product            Product?           @relation(fields: [productId], references: [id])
  campaignId         String?
  campaign           Campaign?          @relation(fields: [campaignId], references: [id])
  calendarEventId    String?
  calendarEvent      MediaCalendarEvent? @relation(fields: [calendarEventId], references: [id])
  requirementType    String           @default("Poster")
  objective          String?
  description        String?
  priority           String           @default("MEDIUM")
  estimatedCompletion DateTime?
  status             String           @default("DRAFT")
  revisionCount      Int              @default(0)
  technicalReviewApproved Boolean     @default(false)
  mediaManagerApproved    Boolean     @default(false)
  clientConfirmed         Boolean     @default(false)
  remarks            String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  tasks              Task[]
  files              FileMetadata[]
  timeline           GraphicRequirementTimeline[]
  remarksHistory     GraphicRequirementRemark[]
  deliverables       GraphicRequirementDeliverable[]
  sourceForCalendarEvents MediaCalendarEvent[]     @relation("CalendarEventSourceGraphicReq")
}

model GraphicRequirementDeliverable {
  id                   String             @id @default(uuid())
  graphicRequirementId String
  graphicRequirement   GraphicRequirement @relation(fields: [graphicRequirementId], references: [id], onDelete: Cascade)
  name                 String
  type                 String?
  description          String?
  fileUrl              String?
  fileName             String?
  fileSize             Int?
  status               String             @default("DRAFT")
  remarks              String?
  submissionDate       DateTime?
  createdById          String?
  createdBy            User?              @relation("GraphicDeliverableCreatedBy", fields: [createdById], references: [id])
  assignedStaffId      String?
  assignedStaff        User?              @relation("GraphicDeliverableAssignedStaff", fields: [assignedStaffId], references: [id])
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
}

model GraphicRequirementTimeline {
  id                   String             @id @default(uuid())
  graphicRequirementId String
  graphicRequirement   GraphicRequirement @relation(fields: [graphicRequirementId], references: [id], onDelete: Cascade)
  userId               String?
  user                 User?              @relation(fields: [userId], references: [id])
  event                String             // REQUIREMENT_CREATED, ASSIGNED, PRODUCTION_STARTED, PRODUCTION_UPDATED, TECHNICAL_REVIEW, MEDIA_REVIEW, CLIENT_CONFIRMATION, REVISION_REQUESTED, COMPLETED
  description          String
  createdAt            DateTime           @default(now())
}

model GraphicRequirementRemark {
  id                   String             @id @default(uuid())
  graphicRequirementId String
  graphicRequirement   GraphicRequirement @relation(fields: [graphicRequirementId], references: [id], onDelete: Cascade)
  userId               String
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  message              String
  createdAt            DateTime           @default(now())
}

model Task {
  id                  String             @id @default(uuid())
  taskId              String             @unique
  title               String
  description         String?
  projectId           String?
  project             ShootProject?      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scriptId            String?
  script              Script?            @relation(fields: [scriptId], references: [id])
  graphicRequirementId String?
  graphicRequirement  GraphicRequirement? @relation(fields: [graphicRequirementId], references: [id])
  clientId            String?
  client              Client?            @relation(fields: [clientId], references: [id])
  brandId             String?
  brand               Brand?             @relation(fields: [brandId], references: [id])
  productId           String?
  product             Product?           @relation(fields: [productId], references: [id])
  priority            String             @default("MEDIUM")
  dueDate             DateTime
  estimatedHours      Float              @default(2.0)
  status              String             @default("PENDING")
  completionPercentage Int               @default(0)
  remarks             String?
  activeDeliverableUrl String?
  activeDeliverableFileName String?
  activeDeliverableVersion Int           @default(0)
  sourceType          String             @default("DIRECT_TASK") // DIRECT_TASK, CALENDAR_EVENT, GRAPHIC_REQUIREMENT, REVISION
  taskType            String             @default("PRODUCTION_TASK") // PRODUCTION_TASK, REVISION
  revisionId          String?
  technicalReviewApproved Boolean        @default(false)
  mediaManagerApproved    Boolean        @default(false)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  assignedEmployees   TaskAssignment[]
  remarksHistory      TaskRemark[]
  deliverableHistory  TaskDeliverableHistory[]
  timeline            TaskTimeline[]
  revisions           Revision[]
}

model TaskTimeline {
  id          String   @id @default(uuid())
  taskId      String
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  event       String   // TASK_CREATED, TASK_ASSIGNED, EMPLOYEE_ACCEPTED, STATUS_CHANGED, PROGRESS_UPDATED, FILE_UPLOADED, REMARK_ADDED, COMPLETED
  description String
  createdAt   DateTime @default(now())
}

model TaskDeliverableHistory {
  id          String   @id @default(uuid())
  taskId      String
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileUrl     String
  fileName    String
  version     Int
  createdAt   DateTime @default(now())
}

model TaskRemark {
  id        String   @id @default(uuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   String
  createdAt DateTime @default(now())
}

model TaskAssignment {
  id               String    @id @default(uuid())
  taskId           String
  userId           String
  task             Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  acceptanceStatus String    @default("NOT_YET_ACCEPTED") // ACCEPTED, NOT_YET_ACCEPTED
  acceptedAt       DateTime?
  assignedAt       DateTime  @default(now())

  @@unique([taskId, userId])
}

model Equipment {
  id                 String                @id @default(uuid())
  equipmentId        String                @unique
  name               String
  category           String
  categoryId         String?
  categoryRef        EquipmentCategory? @relation(fields: [categoryId], references: [id])
  brand              String
  model              String
  serialNumber       String                @unique
  condition          String                @default("Good")
  availability       String                @default("AVAILABLE") // AVAILABLE, RESERVED, ISSUED, MAINTENANCE, DAMAGED, RETIRED
  maintenanceStatus  String                @default("OPERATIONAL") // OPERATIONAL, NEEDS_SERVICE, UNDER_REPAIR, DECOMMISSIONED
  currentHolder      String?
  internalNotes      String?
  storageLocation    String?               // New field for storage location
  status             String                @default("AVAILABLE") // Current status of equipment

  // ─── Permanent Inventory Record Fields (Business Rule 2) ───────────────────
  purchaseDate       DateTime?             // Date asset was acquired by the company
  purchaseCost       Float?                // Original acquisition cost
  purchaseRef        String?               // PO number / invoice reference

  // ─── Company Ownership (Business Rule 1) ──────────────────────────────────
  ownedBy            String                @default("COMPANY")  // Always COMPANY — never personal

  // ─── Archive / Retirement Fields (Business Rules 3 & 4) ──────────────────
  isArchived         Boolean               @default(false)      // true = retired & archived
  archivedAt         DateTime?             // Timestamp of retirement
  retirementReason   String?               // Why the equipment was retired

  // ─── Lost Equipment Tracking Fields ───────────────────────────────────────
  lastResponsibleEmployeeId String?
  lastKnownLocation         String?
  lastKnownDate             DateTime?
  lostNotes                 String?

  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  reservations            EquipmentReservation[]
  movements               EquipmentMovement[]
  requests                EquipmentRequest[]
  damageReports           EquipmentDamageReport[]
  handoverAuthorizations  EquipmentHandoverAuthorization[]
  maintenanceRecords      EquipmentMaintenanceRecord[]
}

model EquipmentReservation {
  id          String   @id @default(uuid())
  projectId   String
  equipmentId String
  project     ShootProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  equipment   Equipment    @relation(fields: [equipmentId], references: [id], onDelete: Restrict) // Business Rule 3: parent record never deleted
  startDate   DateTime
  endDate     DateTime
  reservedById String?
  reservedBy   User?   @relation("ReservationCreator", fields: [reservedById], references: [id])
  expectedCheckout DateTime?
  status      String   @default("RESERVED")
  createdAt   DateTime @default(now())
}

model EquipmentRequest {
  id                 String       @id @default(uuid())
  equipmentId        String
  equipment          Equipment    @relation(fields: [equipmentId], references: [id], onDelete: Restrict)
  projectId          String
  project            ShootProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requestedById      String
  requestedBy        User         @relation("EquipmentRequester", fields: [requestedById], references: [id])
  purpose            String
  requiredDate       DateTime
  expectedReturnDate DateTime
  remarks            String?
  status             String       @default("PENDING") // PENDING, APPROVED, REJECTED, CHECKED_OUT, CANCELLED
  reviewedById       String?
  reviewedBy         User?        @relation("EquipmentRequestReviewer", fields: [reviewedById], references: [id])
  reviewNotes        String?
  
  // Preparation & Handover Fields
  isPrepared               Boolean      @default(false)
  preparedAt               DateTime?
  preparedById             String?
  preparationNotes         String?
  accessoriesChecked       String?
  handoverAuthorizationId  String?

  isAcknowledged           Boolean      @default(false)
  acknowledgedAt           DateTime?
  acknowledgedByName       String?
  acknowledgementStatement String?
  createdAt                DateTime     @default(now())
  updatedAt                DateTime     @updatedAt

  handoverAuthorizations   EquipmentHandoverAuthorization[]

  @@index([equipmentId])
  @@index([projectId])
  @@index([requestedById])
}

model EquipmentMovement {
  id                 String                 @id @default(uuid())
  equipmentId        String
  projectId          String?
  userId             String
  employeeId         String?
  employee           User?                  @relation("EquipmentIssuedTo", fields: [employeeId], references: [id])
  approvedById       String?
  approvedBy         User?                  @relation("EquipmentApprovedBy", fields: [approvedById], references: [id])
  expectedReturnDate DateTime?
  action             String                 // ISSUED, USED, RETURNED, RETIRED, PREPARED, INSPECTED, DAMAGED, MAINTENANCE, LOST
  returnedById       String?
  returnedBy         User?                  @relation("EquipmentReturnedBy", fields: [returnedById], references: [id])
  returnedByName     String?
  condition          String?
  hasPhysicalDamage  Boolean                @default(false)
  physicalDamageNotes String?
  hasMissingAccessories Boolean               @default(false)
  missingAccessoriesNotes String?
  functionalCondition String?
  cleaningStatus     String?
  notes              String?
  timestamp          DateTime               @default(now())

  equipment   Equipment              @relation(fields: [equipmentId], references: [id], onDelete: Restrict) // Business Rule 3: movement log preserved
  project     ShootProject?          @relation(fields: [projectId], references: [id])
  user        User                   @relation(fields: [userId], references: [id])
}

model EquipmentDamageReport {
  id           String       @id @default(uuid())
  equipmentId  String
  equipment    Equipment    @relation(fields: [equipmentId], references: [id], onDelete: Restrict)
  reportedById String
  reportedBy   User         @relation("EquipmentDamageReporter", fields: [reportedById], references: [id])
  date         DateTime     @default(now())
  description  String
  severity     String       // LOW, MEDIUM, HIGH, CRITICAL
  repairStatus String       @default("PENDING") // PENDING, IN_REPAIR, REPAIRED, UNREPAIRABLE
  repairNotes  String?
  repairedAt   DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([equipmentId])
  @@index([reportedById])
}

model EquipmentHandoverAuthorization {
  id                      String           @id @default(uuid())
  authorizationId         String           @unique
  requestId               String
  request                 EquipmentRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  equipmentId             String
  equipment               Equipment        @relation(fields: [equipmentId], references: [id], onDelete: Restrict)
  employeeId              String
  employee                User             @relation("HandoverToEmployee", fields: [employeeId], references: [id])
  issuedById              String
  issuedBy                User             @relation("HandoverIssuedBy", fields: [issuedById], references: [id])
  projectId               String?
  project                 ShootProject?    @relation(fields: [projectId], references: [id])
  condition               String           @default("Good")
  accessoriesIncluded     String?
  acknowledgedAt          DateTime?
  acknowledgementStatement String?
  remarks                 String?
  createdAt               DateTime         @default(now())

  @@index([requestId])
  @@index([equipmentId])
  @@index([employeeId])
}

model EquipmentMaintenanceRecord {
  id              String      @id @default(uuid())
  maintenanceId   String      @unique
  equipmentId     String
  equipment       Equipment   @relation(fields: [equipmentId], references: [id], onDelete: Restrict)
  maintenanceType String      // ROUTINE_SERVICE, REPAIR, INSPECTION, CLEANING
  performedBy     String
  cost            Float?
  status          String      @default("SCHEDULED") // SCHEDULED, IN_PROGRESS, COMPLETED, FAILED
  scheduledDate   DateTime    @default(now())
  completedDate   DateTime?
  notes           String?
  clearedById     String?
  clearedBy       User?       @relation("MaintenanceClearedBy", fields: [clearedById], references: [id])
  clearedAt       DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([equipmentId])
}

model Attendance {
  id           String    @id @default(uuid())
  userId       String
  date         DateTime
  status       String    @default("PRESENT") // PRESENT, LATE, HALF_DAY, ABSENT
  remarks      String?
  recordedById String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user         User      @relation("AttendanceUser", fields: [userId], references: [id], onDelete: Cascade)
  recordedBy   User?     @relation("AttendanceRecordedBy", fields: [recordedById], references: [id])

  @@unique([userId, date])
}

model Approval {
  id            String        @id @default(uuid())
  projectId     String?
  project       ShootProject? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  entityType    String        @default("PROJECT") // PROJECT, SCRIPT, GRAPHIC_REQ, TASK, EQUIPMENT
  entityId      String?
  approvalType  String        @default("TECHNICAL_REVIEW") // TECHNICAL_REVIEW, MEDIA_MANAGER_REVIEW
  targetRole    String        @default("TECHNICAL_MANAGER") // TECHNICAL_MANAGER, MEDIA_MANAGER
  requestedById String?
  requestedBy   User?         @relation("ApprovalRequester", fields: [requestedById], references: [id], onDelete: Cascade)
  reviewerId    String?
  reviewer      User?         @relation("Approver", fields: [reviewerId], references: [id])
  status        String        @default("PENDING") // PENDING, APPROVED, REJECTED, CHANGES_REQUESTED
  remarks       String?
  reviewedAt    DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @default(now()) @updatedAt
}

model ClientConfirmation {
  id                  String         @id @default(uuid())
  projectId           String
  project             ShootProject   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  decision            String         // APPROVED, REVISION_REQUESTED, REJECTED
  decisionDate        DateTime       @default(now())
  communicationMethod String         @default("WhatsApp")
  remarks             String?
  recordedBy          String
  createdAt           DateTime       @default(now())
}

model Revision {
  id                     String        @id @default(uuid())
  entityType             String        @default("PROJECT") // PROJECT, TASK, SCRIPT, GRAPHIC_REQ, CALENDAR, DELIVERABLE
  entityId               String
  projectId              String?
  project                ShootProject? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  revisionNumber         Int           @default(1)
  reason                 String
  detailedRequest        String
  priority               String        @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  dueDate                DateTime?
  specificArea           String?
  reviewerComments       String?
  reviewStage            String        @default("TECHNICAL_REVIEW") // TECHNICAL_REVIEW, MEDIA_REVIEW, CLIENT_REVIEW
  requestedById          String
  requestedBy            User          @relation("RevisionRequestedBy", fields: [requestedById], references: [id])
  originalAssigneeId     String
  originalAssignee       User          @relation("RevisionOriginalAssignee", fields: [originalAssigneeId], references: [id])
  assignedToId           String
  assignedTo             User          @relation("RevisionAssignedTo", fields: [assignedToId], references: [id])
  taskId                 String?
  task                   Task?         @relation(fields: [taskId], references: [id], onDelete: SetNull)
  status                 String        @default("REVISION_REQUESTED") // REVISION_REQUESTED, IN_PROGRESS, SUBMITTED, APPROVED, COMPLETED
  previousVersionUrl     String?
  revisedVersionUrl      String?
  referenceAttachmentUrl String?
  submittedAt            DateTime?
  resolvedAt             DateTime?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
}

model FileMetadata {
  id                   String              @id @default(uuid())
  fileName             String
  fileSize             Int
  fileType             String
  storagePath          String
  activeVersion        Boolean             @default(true)
  attachmentCategory   String              @default("SCRIPT_DOCUMENT")
  projectId            String
  project              ShootProject        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scriptId             String?
  script               Script?             @relation(fields: [scriptId], references: [id])
  graphicRequirementId String?
  graphicRequirement  GraphicRequirement? @relation(fields: [graphicRequirementId], references: [id])
  uploadedById         String
  uploadedBy           User                @relation(fields: [uploadedById], references: [id])
  createdAt            DateTime            @default(now())
}

model Communication {
  id                   String            @id @default(uuid())
  entityType           String            // PROJECT, SCRIPT, GRAPHIC_REQ, TASK, EQUIPMENT, APPROVAL, REVIEW (Related Module)
  entityId             String
  projectId            String?
  project              ShootProject?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  senderId             String
  sender               User              @relation("CommunicationSender", fields: [senderId], references: [id], onDelete: Cascade)
  assignedToId         String?
  assignedTo           User?             @relation("BlockerAssignedTo", fields: [assignedToId], references: [id])
  parentId             String?
  parent               Communication?    @relation("CommunicationReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies              Communication[]   @relation("CommunicationReplies")
  attachments          CommunicationAttachment[]
  isRemark             Boolean           @default(false)
  isBlocker            Boolean           @default(false)
  isAnnouncement       Boolean           @default(false)
  priority             String?           @default("NORMAL_PRIORITY") // HIGH_PRIORITY, NORMAL_PRIORITY
  blockerReason        String?           // WAITING_FOR_FILES, EQUIPMENT_UNAVAILABLE, CLIENT_CLARIFICATION_REQUIRED, MISSING_ASSETS, TECHNICAL_ISSUE, OTHER
  blockerStatus        String?           @default("OPEN") // OPEN, RESOLVED
  resolvedAt           DateTime?
  resolvedById         String?
  resolvedBy           User?             @relation("BlockerResolvedBy", fields: [resolvedById], references: [id])
  resolutionNotes      String?
  recipients           String?           @default("All Assigned Team Members")
  subject              String?           @default("Operational Communication")
  type                 String            @default("GENERAL_NOTE")
  content              String
  status               String            @default("SENT") // SENT, DELIVERED, READ, CLOSED
  deliveredAt          DateTime?
  readAt               DateTime?
  closedAt             DateTime?
  publishDate          DateTime          @default(now())
  expiryDate           DateTime?
  createdAt            DateTime          @default(now())
}

model CommunicationAttachment {
  id              String        @id @default(uuid())
  communicationId String
  communication   Communication @relation(fields: [communicationId], references: [id], onDelete: Cascade)
  fileName        String
  fileUrl         String
  fileType        String        // DOCUMENT, IMAGE, VIDEO, AUDIO, REFERENCE
  fileSize        Int?
  createdAt       DateTime      @default(now())
}

model Notification {
  id                    String   @id @default(uuid())
  userId                String
  user                  User     @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  title                 String
  message               String
  type                  String   @default("INFO") // INFO, WARNING, SUCCESS, ALERT, ERROR
  category              String   @default("INFORMATION") // 14 Standard Notification Categories
  priority              String   @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  status                String   @default("UNREAD") // UNREAD, READ, ARCHIVED (Business Rule: Never deleted)
  isRead                Boolean  @default(false)
  linkUrl               String?

  // ── Audit Records & Timestamp History (Business Rules) ──
  deliveredAt           DateTime @default(now())
  readAt                DateTime?
  readById              String?
  readBy                User?    @relation("NotificationReadBy", fields: [readById], references: [id])
  archivedAt            DateTime?

  // ── Operational Event & Originating Entity Mandatory References (Business Rule) ──
  eventType             String   @default("GENERAL_EVENT") // e.g. PROJECT_CREATED, TASK_ASSIGNED, SCRIPT_APPROVED, etc.
  entityType            String   @default("SYSTEM")        // PROJECT, TASK, SCRIPT, GRAPHIC_REQUIREMENT, EQUIPMENT, ATTENDANCE, CALENDAR_EVENT, APPROVAL, COMMUNICATION
  entityId              String   @default("")              // ID of originating entity
  entityCode            String?                            // e.g. SP-000001, TSK-000001, GR-000001, EQ-000001, SC-000001
  metadata              String?                            // JSON metadata describing the event snapshot

  // Foreign keys linking to specific operational entities
  projectId             String?
  taskId                String?
  scriptId              String?
  graphicRequirementId String?
  equipmentId           String?
  attendanceId          String?
  calendarEventId       String?
  approvalId            String?
  communicationId       String?

  createdAt             DateTime @default(now())
}

model ActivityLog {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  action      String
  entity      String
  entityId    String
  description String
  metadata    String?
  timestamp   DateTime @default(now())
}

model OutputFormula {
  id              String   @id @default(uuid())
  deliverableType String   @unique
  quantity        Int      @default(1)
  outputValue     Float    @default(1.0)
  description     String?
  updatedAt       DateTime @updatedAt
}

model SystemSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}

model EquipmentCategory {
  id          String   @id @default(uuid())
  name        String   @unique
  createdAt   DateTime @default(now())
  createdById String?
  createdBy   User?    @relation("CreatedByUser", fields: [createdById], references: [id])
  equipments   Equipment[]
}

model SavedFilter {
  id          String   @id @default(uuid())
  userId      String
  name        String
  icon        String?
  module      String   @default("ALL")
  filters     String   // JSON serialized filter criteria
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

model Favorite {
  id          String   @id @default(uuid())
  userId      String
  entityType  String   // PROJECT, SCRIPT, GRAPHIC_REQUIREMENT, TASK, REPORT
  entityId    String
  title       String
  code        String?
  url         String
  metadata    String?  // JSON string for additional context (e.g. status, brand, priority)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, entityType, entityId])
  @@index([userId])
  @@index([userId, entityType])
}

model RecentAccess {
  id          String   @id @default(uuid())
  userId      String
  entityType  String   // PROJECT, SCRIPT, REPORT, EQUIPMENT, GRAPHIC_REQUIREMENT, TASK
  entityId    String
  title       String
  code        String?
  url         String
  metadata    String?  // JSON string for additional context (e.g. status, location, category)
  accessedAt  DateTime @default(now())

  @@unique([userId, entityType, entityId])
  @@index([userId])
  @@index([userId, accessedAt])
}

model ClientAssignment {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, clientId])
}

model CalendarEventRevision {
  id                 String                    @id @default(uuid())
  calendarEventId    String
  calendarEvent      MediaCalendarEvent        @relation(fields: [calendarEventId], references: [id], onDelete: Cascade)
  version            Int
  title              String
  caption            String?
  contentType        String?
  platform           String?
  creativePreviewUrl String?
  productionNotes    String?
  createdById        String
  createdBy          User                      @relation(fields: [createdById], references: [id])
  createdAt          DateTime                  @default(now())

  approvalHistory    CalendarApprovalHistory[]
}

model CalendarApprovalHistory {
  id              String                 @id @default(uuid())
  calendarEventId String
  calendarEvent   MediaCalendarEvent     @relation(fields: [calendarEventId], references: [id], onDelete: Cascade)
  revisionId      String?
  revision        CalendarEventRevision? @relation(fields: [revisionId], references: [id], onDelete: SetNull)
  version         Int
  userId          String
  user            User                   @relation(fields: [userId], references: [id])
  role            String
  action          String                 // SUBMITTED, CLIENT_APPROVED, CHANGES_REQUESTED, REJECTED, RESUBMITTED, OVERRIDDEN
  previousStatus  String
  newStatus       String
  comment         String?
  timestamp       DateTime               @default(now())
}

model CalendarEditRequest {
  id                 String             @id @default(uuid())
  calendarEventId    String
  calendarEvent      MediaCalendarEvent @relation(fields: [calendarEventId], references: [id], onDelete: Cascade)
  status             String             @default("PENDING_MARKETING_APPROVAL") // PENDING_MARKETING_APPROVAL, APPROVED, REJECTED, CHANGES_REQUESTED, CANCELLED
  requestedById      String
  requestedBy        User               @relation("CalendarEditRequestedBy", fields: [requestedById], references: [id])
  requestedAt        DateTime           @default(now())
  reason             String?
  originalValues     String             // JSON serialized object of original values before edit request
  requestedValues    String             // JSON serialized object of requested changes
  reviewedById       String?
  reviewedBy         User?              @relation("CalendarEditReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt         DateTime?
  reviewComment      String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([calendarEventId])
  @@index([status])
}

model CalendarEditHistory {
  id                 String             @id @default(uuid())
  calendarEventId    String
  calendarEvent      MediaCalendarEvent @relation(fields: [calendarEventId], references: [id], onDelete: Cascade)
  requestId          String?
  requestedById      String
  requestedBy        User               @relation("CalendarEditHistoryRequestedBy", fields: [requestedById], references: [id])
  requestedAt        DateTime
  approvedById       String
  approvedBy         User               @relation("CalendarEditHistoryApprovedBy", fields: [approvedById], references: [id])
  approvedAt         DateTime           @default(now())
  changes            String             // JSON string detailing changes: { field: { from, to } }
  createdAt          DateTime           @default(now())

  @@index([calendarEventId])
}



