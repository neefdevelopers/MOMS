# Database connection string (e.g. Neon PostgreSQL)
DATABASE_URL=

# Authentication
JWT_SECRET=
JWT_EXPIRES_IN=

# Server Configuration
PORT=4000
NODE_ENV=production

# CORS allowed frontend origin(s) (e.g. https://your-app.vercel.app or comma-separated)
FRONTEND_URL=

# Optional local storage directory override
UPLOAD_DIR=
